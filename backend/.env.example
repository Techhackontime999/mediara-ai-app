# ---------------------------------------------------------------------------
# Mediara AI backend — environment configuration
# ---------------------------------------------------------------------------
#  1. Copy this file to .env:            cp .env.example .env   (Windows: Copy-Item)
#  2. Fill in the values marked "must set" for your environment.
#  3. NEVER commit .env. Production values belong in a secret manager.
#
# Every variable is optional unless it says so — defaults let the project run
# locally with zero configuration (SQLite + deterministic local AI engine).
#
# Generate a secret key / encryption key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------


# ---------- General ----------------------------------------------------------
# Runtime environment label (also sent to Sentry).
APP_ENV=development
# Timezone for the backend (stored datetimes are always UTC).
DJANGO_TIME_ZONE=UTC


# ---------- Core security -----------------------------------------------------
# MUST SET in production — long, random secret (see the header above).
DJANGO_SECRET_KEY=change-me-in-production
# MUST SET False in production. Never expose debug/tracebacks publicly.
DJANGO_DEBUG=True
# Comma-separated hosts allowed to reach this API.
DJANGO_ALLOWED_HOSTS=api.mediara.ai,localhost,127.0.0.1
# Optional: origins allowed to send cookies (web admin / reverse proxy).
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.mediara.ai
# Path to the Django admin. Change this in production to hide /admin/.
# (Do not use an empty value; "django-admin-xyz" is a good obfuscation.)
ADMIN_URL=admin


# ---------- Bootstrap: first superuser (from environment) ----------------------
# Creates the admin account on first boot — no interactive prompts needed.
# Works on bare metal, Docker, and CI. Run manually with:
#   python manage.py ensure_superuser
# The Docker entrypoint runs it automatically after `migrate`.
# SECURITY: remove DJANGO_SUPERUSER_PASSWORD (or rotate the password) after
# the first boot; keep it in your secret manager, never in a public repo.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_NAME=Site Administrator
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-strong-password


# ---------- Security hardening (DRY RUN flags for strict TLS setups) -----------
# These default to strict values automatically when DJANGO_DEBUG=False. The
# flags below let you override per environment, e.g. HSTS before/after your
# reverse proxy is finished, or SSL-redirect where TLS terminates on the proxy.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_X_FRAME_OPTIONS=DENY
# Python logging level for the Django/AI/audit loggers: DEBUG INFO WARNING ERROR
LOG_LEVEL=INFO


# ---------- Database -----------------------------------------------------------
# Engine — SQLite is the zero-config local default. For production choose
# postgres or mysql. MongoDB is an *auxiliary* store (see below).
#
#   DB_ENGINE    = "sqlite" (default) | "postgres" | "mysql"
#   DATABASE_URL = single 12-factor connection string that WINS over the
#                  individual *_HOST / *_VARS below:
#
#     postgres://USER:PASS@HOST:5432/DBNAME     (PostgreSQL / Supabase / Neon)
#     mysql://USER:PASS@HOST:3306/DBNAME        (MySQL / MariaDB)
#     sqlite:///db.sqlite3                      (SQLite, relative to backend/)
#
DB_ENGINE=sqlite
DATABASE_URL=

# --- PostgreSQL (engine default for production; Supabase/Neon/RDS are just
#     PostgreSQL — use their dashboard host, password and
#     POSTGRES_SSLMODE=require / verify-full for TLS). ------------------------
DB_POSTGRES=False
POSTGRES_DB=mediara
POSTGRES_USER=mediara
# MUST SET a strong password in production.
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Keep DB connections alive between requests (seconds). Use 60 in production.
POSTGRES_CONN_MAX_AGE=60
# TLS mode for the DB connection: disable | allow | prefer | require | verify-full
# (managed clouds like RDS/Cloud SQL/Supabase/Neon usually use "require").
POSTGRES_SSLMODE=

# --- MySQL / MariaDB ----------------------------------------------------------
# Supported as an alternative production engine (DB_ENGINE=mysql). The shell
# above works for the container topology; bare-metal just uses these vars.
MYSQL_DB=mediara
MYSQL_USER=mediara
MYSQL_PASSWORD=change-me
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60

# --- MongoDB (OPTIONAL auxiliary store) ---------------------------------------
# Core relational data always lives in the ORM DB above. Setting MONGO_URL
# additionally enables a MongoDB connection for unstructured/analytics data
# via config.mongo.get_mongo_client() — see docs/DATABASE.md.
#   Local:        mongodb://127.0.0.1:27017
#   Atlas/mobile: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net
#   DigitalOcean: mongodb://doadmin:PASS@db-mongo-xxxx.ondigitalocean.com:27017
MONGO_URL=
MONGO_DB=mediara


# ---------- JWT lifetimes -------------------------------------------------------
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=30


# ---------- CORS (only needed for a browser-based admin; native Android ign on CORS) --
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=False


# ---------- Channels / WebSockets ------------------------------------------------
# Set CHANNELS_REDIS=True for a Redis channel layer (required for multi-worker
# production deployments). In-memory layer is fine for local dev / single process.
CHANNELS_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0


# ---------- AI / LLM provider ----------------------------------------------------
# ANY OpenAI-compatible provider is supported via base URL + key, plus native
# Gemini. The Android app never reads or embeds these.
#
#   AI_PROVIDER = "auto" (default) | "gemini" | "openai"
#       auto: if AI_BASE_URL points to a Google endpoint -> native Gemini,
#             otherwise OpenAI-compatible chat/completions.
#
#   AI_BASE_URL = base of an OpenAI-compatible API, e.g.:
#       https://api.openai.com/v1          (OpenAI)
#       https://api.groq.com/openai/v1     (Groq)
#       https://openrouter.ai/api/v1       (OpenRouter)
#       https://api.mistral.ai/v1          (Mistral)
#       http://localhost:11434/v1          (local Ollama - no API key needed)
#       http://localhost:1234/v1           (LM Studio - no API key needed)
#       https://router.huggingface.co/v1   (Hugging Face)
#
#   AI_API_KEY = provider key. Leave empty ONLY for local Ollama / LM Studio.
#   AI_MODEL   = model id, e.g. gpt-4o-mini, llama-3.1-8b-instant, llama3.1
#
# Legacy (still supported):
#   GEMINI_API_KEY = Google AI Studio key (https://aistudio.google.com/apikey)
#   GEMINI_MODEL   = gemini-2.5-flash
#
# If no key/base URL is set at all, the built-in deterministic mediation engine
# is used (still fully functional for the whole flow).
AI_PROVIDER=auto
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# When True (default), AI provider failures fall back to the deterministic
# engine so the whole mediation flow keeps working. Set False to surface errors.
AI_FALLBACK_ENABLED=True


# ---------- Client reachability --------------------------------------------------
# Public base URL the Android app should use to reach this backend.
# 10.0.2.2 = host loopback from the Android emulator.
PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Safety: where to point users during a safety hold.
SAFETY_SUPPORT_EMAIL=support@mediara.ai


# ---------- Email / notifications ------------------------------------------------
# Optional; console backend is used by default — verification codes and
# notification emails print to the server console when unset. For real mail set
# EMAIL_HOST (e.g. smtp.gmail.com) and use an App Password, not your account one.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Alternative for some providers (e.g. port 465 with implicit TLS):
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Mediara AI <no-reply@mediara.ai>

# Admin / staff addresses that receive operational messages (optional).
# Comma-separated list of emails for the daily / error notification receivers.
ADMIN_NOTIFY_EMAILS=


# ---------- Encryption at rest -----------------------------------------------------
# A Fernet key (base64, 32 random bytes). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a local auto-generated backend/entropy.key is used (dev only).
# MUST SET and BACKED UP in production — losing it makes private messages
# undecryptable (unrecoverable by design).
ENCRYPTION_KEY=


# ---------- API rate limiting -------------------------------------------------------
# Throttles (requests per minute). "auth" applies to login/register; "mfa" to
# MFA verify; "login" gates password attempts per user to blunt brute force.
THROTTLE_ANON=30/minute
THROTTLE_USER=200/minute
THROTTLE_AUTH=10/minute
THROTTLE_LOGIN=5/minute
THROTTLE_MFA=5/minute


# ---------- Observability -----------------------------------------------------------
# Sentry (optional; disabled when SENTRY_DSN is blank).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1


# ---------- Static & media (optional overrides) --------------------------------------
# Where collectstatic writes and media files land. Media files (e.g. agreement
# PDFs) should live on a persistent volume in production.
STATIC_ROOT=
MEDIA_ROOT=
MEDIA_URL=/media/