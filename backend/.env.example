# ---------------------------------------------------------------------------
# Mediara AI backend environment configuration
# Copy this file to .env and fill in values for your deployment.
# ---------------------------------------------------------------------------

# Security ----------------------------------------------------------------
# In production generate a strong random secret:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Comma-separated list of hosts allowed to reach the API (e.g. your_deploy_domain.com,localhost)
DJANGO_ALLOWED_HOSTS=*

# Database — leave DB_POSTGRES unset/False to use local SQLite.
# Set DB_POSTGRES=True and provide the credentials below to use PostgreSQL.
DB_POSTGRES=False
POSTGRES_DB=mediara
POSTGRES_USER=mediara
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT lifetimes
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=30

# CORS (only needed for a future browser-based web client)
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=False

# Channels / WebSockets
# Set CHANNELS_REDIS=True for Redis-backed channel layer (required for
# multi-worker production deployments). In-memory layer is fine for local dev.
CHANNELS_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0

# AI ----------------------------------------------------------------------
# Server-side Gemini API key. The Android app never reads or embeds this.
# You can get a key at https://aistudio.google.com/apikey
# If empty, the built-in deterministic mediation engine is used (still fully
# functional for the whole flow, but without LLM-generated language).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_FALLBACK_ENABLED=True

# Public base URL the Android app should use to reach this backend.
# 10.0.2.2 = host loopback from the Android emulator.
PUBLIC_API_BASE_URL=http://10.0.2.2:8000

SAFETY_SUPPORT_EMAIL=support@mediara.ai

# Email (optional; console backend used by default — verification codes and
# notification emails print to the server console when unset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Mediara AI <no-reply@mediara.ai>

# Encryption at rest — a Fernet key (base64 32-byte). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a local auto-generated backend/entropy.key is used (dev only).
ENCRYPTION_KEY=

# Rate limiting (requests per minute)
THROTTLE_ANON=30/minute
THROTTLE_USER=200/minute
THROTTLE_AUTH=10/minute

# Sentry (optional; leave blank to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1