# GEMINI_API_KEY: Required if the Android app calls the Gemini API directly.
# The current app talks to the Django backend instead, so this is optional.
# AI Studio injects this at runtime from user secrets.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# API_BASE_URL: Base URL of the Django backend baked into the app at build time.
# Default (unset) is http://10.0.2.2:8000/ which works in the Android Studio
# emulator against a backend running on the host. Set it to reach the backend
# from a physical device, e.g.:
# API_BASE_URL=http://192.168.1.20:8000/
#
# Note: this value is read from the process environment at Gradle configuration
# time (System.getenv), not from this file. Export it in the shell before running
# ./gradlew, you do not need it in .env.